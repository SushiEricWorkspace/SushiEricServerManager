<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.sushiericworkspace.sushiericservermanager.feature.moneyhistory.MoneyHistoryController"
            prefWidth="1100" prefHeight="640" minWidth="0" styleClass="money-history-root">
    <center>
        <TabPane minWidth="0" focusTraversable="false" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="入出金">
                    <content>
                        <VBox minWidth="0" spacing="10" styleClass="money-history-content">
                            <FlowPane fx:id="playerFilters" minWidth="0" hgap="8" vgap="8" alignment="CENTER_LEFT">
                                <Label text="プレイヤー" minWidth="0" styleClass="history-filter-label"  prefWidth="95" maxWidth="${playerFilters.width}" />
                                <VBox fx:id="playerSelectorPane" minWidth="0" prefWidth="340" maxWidth="${playerFilters.width}"  />
                                <ToggleButton fx:id="playerDisplayToggle" minWidth="0" prefWidth="110" onAction="#togglePlayerDisplay"  maxWidth="${playerFilters.width}" />
                                <Button text="更新" minWidth="0" prefWidth="75" onAction="#reloadSelected"  maxWidth="${playerFilters.width}" />
                            </FlowPane>
                            <VBox spacing="8">
                                <FlowPane fx:id="fromFilters" minWidth="0" hgap="8" vgap="8" alignment="CENTER_LEFT">
                                    <Label text="開始" minWidth="0" styleClass="history-filter-label"  prefWidth="60" maxWidth="${fromFilters.width}" />
                                    <DatePicker fx:id="fromDate" promptText="YYYY/MM/DD" minWidth="0" prefWidth="180" maxWidth="${fromFilters.width}"  />
                                    <TextField fx:id="fromTime" promptText="HH:mm:ss" minWidth="0" prefWidth="105" maxWidth="${fromFilters.width}"  />
                                    <Button text="時刻を選択" onAction="#selectFromTime"  minWidth="0" maxWidth="${fromFilters.width}" />
                                    <Button text="現在時刻" onAction="#setFromNow"  minWidth="0" maxWidth="${fromFilters.width}" />
                                    <Button text="今日" onAction="#setFromToday"  minWidth="0" maxWidth="${fromFilters.width}" />
                                    <Button text="リセット" onAction="#resetFrom"  minWidth="0" maxWidth="${fromFilters.width}" />
                                </FlowPane>
                                <FlowPane fx:id="toFilters" minWidth="0" hgap="8" vgap="8" alignment="CENTER_LEFT">
                                    <Label text="終了" minWidth="0" styleClass="history-filter-label"  prefWidth="60" maxWidth="${toFilters.width}" />
                                    <DatePicker fx:id="toDate" promptText="YYYY/MM/DD" minWidth="0" prefWidth="180" maxWidth="${toFilters.width}"  />
                                    <TextField fx:id="toTime" promptText="HH:mm:ss" minWidth="0" prefWidth="105" maxWidth="${toFilters.width}"  />
                                    <Button text="時刻を選択" onAction="#selectToTime"  minWidth="0" maxWidth="${toFilters.width}" />
                                    <Button text="現在時刻" onAction="#setToNow"  minWidth="0" maxWidth="${toFilters.width}" />
                                    <Button text="今日" onAction="#setToToday"  minWidth="0" maxWidth="${toFilters.width}" />
                                    <Button text="リセット" onAction="#resetTo"  minWidth="0" maxWidth="${toFilters.width}" />
                                </FlowPane>
                                <FlowPane fx:id="conditionFilters" minWidth="0" hgap="8" vgap="8" alignment="CENTER_LEFT">
                                    <Label text="種別" minWidth="0" styleClass="history-filter-label"  prefWidth="60" maxWidth="${conditionFilters.width}" />
                                    <MenuButton fx:id="typeMenu" text="すべて" minWidth="0" prefWidth="150" maxWidth="${conditionFilters.width}"  />
                                    <Button text="条件をリセット" onAction="#resetFilters"  minWidth="0" maxWidth="${conditionFilters.width}" />
                                </FlowPane>
                            </VBox>
                            <Label wrapText="true" maxWidth="Infinity" fx:id="statusLabel" text="プレイヤーを読み込み中..." />
                            <Label wrapText="true" maxWidth="Infinity" fx:id="nameStatusLabel" text="" />
                            <TableView minWidth="0" fx:id="historyTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="timeColumn" text="日時" prefWidth="145" />
                                    <TableColumn fx:id="typeColumn" text="種別" prefWidth="90" />
                                    <TableColumn fx:id="amountColumn" text="金額" prefWidth="90" />
                                    <TableColumn fx:id="balanceColumn" text="処理後残高" prefWidth="105" />
                                    <TableColumn fx:id="counterpartyColumn" text="相手" prefWidth="175" />
                                    <TableColumn fx:id="executorColumn" text="実行者" prefWidth="175" />
                                    <TableColumn fx:id="reasonColumn" text="理由" prefWidth="180" />
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>
                <Tab fx:id="achievementTab" text="実績">
                    <content>
                        <fx:include fx:id="achievementHistory" source="achievement-history.fxml" />
                    </content>
                </Tab>
                <Tab fx:id="shopTab" text="ショップ" />
            </tabs>
        </TabPane>
    </center>
</BorderPane>
