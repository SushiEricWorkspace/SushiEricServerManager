<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="480.0" prefWidth="760.0"
           styleClass="server-select-root"
           xmlns="http://javafx.com/javafx/21.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="io.github.sushiericworkspace.sushiericservermanager.serverselect.controller.ServerSelector">
    <children>
        <VBox fx:id="mainContent" alignment="TOP_CENTER" spacing="14.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="server-select-header">
                <Label styleClass="server-select-title" text="サーバー選択"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button focusTraversable="false" mnemonicParsing="false"
                        onAction="#handleReturnToModeSelect"
                        styleClass="button, btn-secondary, server-mode-select-button"
                        text="モード選択へ戻る"/>
                <Button focusTraversable="false" mnemonicParsing="false"
                        onAction="#openCreateServerWindow"
                        styleClass="button, btn-primary, server-add-button"
                        text="サーバーを追加"/>
            </HBox>

            <Label maxWidth="1.7976931348623157E308"
                   styleClass="server-select-description"
                   text="接続するサーバーを選択してください"/>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        pannable="true" styleClass="server-list-scroll"
                        vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="serverListContainer" fillWidth="true" spacing="12.0">
                        <padding>
                            <Insets bottom="6.0" left="2.0" right="2.0" top="6.0"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>

        <VBox fx:id="progressOverlay" alignment="CENTER" managed="false"
              mouseTransparent="false" spacing="12.0"
              styleClass="server-progress-overlay" visible="false">
            <ProgressIndicator/>
            <Label fx:id="progressLabel" styleClass="server-progress-label" text="SSH接続中..."/>
        </VBox>
    </children>
</StackPane>
