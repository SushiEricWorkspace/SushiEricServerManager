<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootPane" alignment="CENTER" prefHeight="500.0" prefWidth="620.0"
      styleClass="mode-select-root"
      xmlns="http://javafx.com/javafx/21.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.sushiericworkspace.sushiericservermanager.app.ModeSelectionController">
    <Label styleClass="mode-select-title" text="動作モードを選択"/>
    <Label styleClass="mode-select-description" text="起動後に使用するデータ保存先を選択してください"/>

    <VBox maxWidth="500.0" styleClass="mode-card">
        <Label styleClass="mode-card-title" text="オンラインモード"/>
        <Label styleClass="mode-card-description" text="サーバーへ接続し、データの編集・保存・同期を行います。&#10;起動時に最新版を確認します。" wrapText="true"/>
        <Button fx:id="onlineButton" maxWidth="1.7976931348623157E308" onAction="#selectOnline"
                styleClass="button, btn-primary, mode-select-button" text="オンラインモード"/>
    </VBox>

    <VBox maxWidth="500.0" styleClass="mode-card">
        <Label styleClass="mode-card-title" text="オフラインモード"/>
        <Label styleClass="mode-card-description" text="サーバーへ接続せず、ローカルにデータを作成・編集します。&#10;最新版の確認は行いません。" wrapText="true"/>
        <Button fx:id="offlineButton" maxWidth="1.7976931348623157E308" onAction="#selectOffline"
                styleClass="button, btn-secondary, mode-select-button" text="オフラインモード"/>
    </VBox>
    <VBox maxWidth="500.0" styleClass="mode-card">
        <Label styleClass="mode-card-title" text="管理テスト環境"/>
        <Label styleClass="mode-card-description" text="取得済みの貸出へ接続し、世代・sessionを分離して編集します。SSH/SFTPは使用しません。" wrapText="true"/>
        <Button fx:id="managedButton" maxWidth="1.7976931348623157E308" onAction="#selectManaged"
                styleClass="button, btn-secondary, mode-select-button" text="管理テスト環境へ接続"/>
    </VBox>
</VBox>
