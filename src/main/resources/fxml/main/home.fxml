<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootPane" prefHeight="520.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.sushiericworkspace.sushiericservermanager.editor.controller.HomeController">

    <children>
        <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox styleClass="home-content">
                    <children>
                        <Label maxWidth="1.7976931348623157E308" styleClass="home-title" text="ホーム" />
                        <VBox styleClass="home-status-panel">
                            <children>
                                <Label fx:id="modeLabel" maxWidth="1.7976931348623157E308" styleClass="home-mode-label" />
                                <Label fx:id="managementLabel" maxWidth="1.7976931348623157E308" styleClass="home-mode-label" />
                                <Label fx:id="monitorLabel" maxWidth="1.7976931348623157E308" styleClass="home-mode-label" wrapText="true" />
                            </children>
                        </VBox>
                        <GridPane hgap="16.0" styleClass="home-sections">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" percentWidth="50.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" percentWidth="50.0" />
                            </columnConstraints>
                            <children>
                                <VBox maxWidth="1.7976931348623157E308" styleClass="home-section">
                                    <children>
                                        <Label maxWidth="1.7976931348623157E308" styleClass="home-section-title" text="エディター" />
                                        <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onOpenItemEditor" styleClass="button, data-btn" text="アイテム" />
                                        <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onOpenOreEditor" styleClass="button, data-btn" text="鉱石" />
                                        <Button disable="true" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="button, data-btn, data-btn-unavailable" text="作物（未実装）" />
                                    </children>
                                </VBox>
                                <VBox maxWidth="1.7976931348623157E308" styleClass="home-section" GridPane.columnIndex="1">
                                    <children>
                                        <Label maxWidth="1.7976931348623157E308" styleClass="home-section-title" text="管理ツール" />
                                        <Button fx:id="dashboardButton" focusTraversable="false" maxWidth="1.7976931348623157E308"
                                                mnemonicParsing="false" onAction="#onOpenDashboard"
                                                styleClass="button, data-btn" text="Dashboard" />
                                        <Button fx:id="serverControlButton" focusTraversable="false" maxWidth="1.7976931348623157E308"
                                                mnemonicParsing="false" onAction="#onOpenServerControl"
                                                styleClass="button, data-btn" text="Server Control" />
                                        <Button fx:id="consoleButton" focusTraversable="false" maxWidth="1.7976931348623157E308"
                                                mnemonicParsing="false" onAction="#onOpenConsole"
                                                styleClass="button, data-btn" text="Minecraftコンソール" />
                                        <Button focusTraversable="false" maxWidth="1.7976931348623157E308"
                                                mnemonicParsing="false" onAction="#onOpenModConfig"
                                                styleClass="button, data-btn" text="Mod設定" />
                                        <Button fx:id="uploadLocalButton" focusTraversable="false" maxWidth="1.7976931348623157E308"
                                                mnemonicParsing="false" onAction="#onUploadLocalData"
                                                styleClass="button, btn-secondary, home-upload-button"
                                                text="ローカルデータをアップロード" />
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>
                        <Region VBox.vgrow="ALWAYS" />
                        <Button fx:id="modeSelectButton" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#handleReturnToModeSelect"
                                styleClass="button, btn-secondary, home-back-button"
                                text="モード選択へ戻る" />
                        <Button fx:id="backButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDisconnect" styleClass="button, btn-danger, home-back-button" text="戻る" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
