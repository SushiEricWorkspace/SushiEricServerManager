<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.sushiericworkspace.sushiericservermanager.feature.simulator.SimulatorController"
      prefWidth="1100.0" prefHeight="800.0" spacing="10.0" styleClass="simulator-root">
    <Label text="戦闘シミュレーター" styleClass="simulator-title" />
    <Label text="同じtickの指定順に評価します。飛翔・遅延・ノックバック後の衝突・実環境への効果適用は行いません。" wrapText="true" />
    <Label text="保存済み取込（明示したローカルOFFLINE_DIRだけを読みます）" />
    <HBox spacing="8.0"><TextField fx:id="localRoot" promptText="OFFLINE_DIR絶対パス" HBox.hgrow="ALWAYS"/><TextField fx:id="localId" promptText="Item公開ID"/><ComboBox fx:id="localPart"/><Button text="取得・再読込" onAction="#readLocalItem"/></HBox>
    <Label fx:id="importLabel" wrapText="true" />
    <ScrollPane fitToWidth="true" minHeight="120.0" prefViewportHeight="260.0" VBox.vgrow="ALWAYS"><content><VBox fx:id="inputContainer" /></content></ScrollPane>
    <HBox spacing="10.0">
        <Button text="計算" onAction="#calculate" />
        <Button fx:id="cancelButton" text="取消" onAction="#cancel" disable="true" />
        <Label fx:id="statusLabel" text="未実行" />
    </HBox>
    <Label text="直前の固定要求の結果（入力を変更した後は再計算してください）" />
    <Label fx:id="resultLabel" wrapText="true" minHeight="40.0" />
    <HBox spacing="8.0"><Button text="詳細の前ページ" onAction="#previousDetails"/><Button text="詳細の次ページ" onAction="#nextDetails"/></HBox>
    <TextArea fx:id="detailsArea" editable="false" wrapText="true" prefRowCount="8" minHeight="140.0" maxHeight="200.0" />
    <HBox spacing="8.0"><Button text="基準を保持・更新" onAction="#holdBaseline"/><Button text="比較" onAction="#compare"/><Button text="基準解除" onAction="#clearBaseline"/><Button fx:id="previousComparisonButton" disable="true" text="比較の前ページ" onAction="#previousComparison"/><Button fx:id="nextComparisonButton" disable="true" text="比較の次ページ" onAction="#nextComparison"/></HBox>
    <ScrollPane fitToWidth="true" prefViewportHeight="100.0" minHeight="70.0" maxHeight="180.0"><content><Label fx:id="comparisonLabel" wrapText="true" /></content></ScrollPane>
</VBox>
